NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRON_SECRET=
ANTHROPIC_API_KEY=
FRED_API_KEY=

# --- Live execution (Binance, testnet-first) ---
# Execution stays fully paper unless EXECUTION_ENABLED=true AND keys are set.
EXECUTION_ENABLED=false
# true (default) = testnet.binance.vision. Setting this to false is NOT enough
# to send real orders. Real money also requires LIVE_TRADING_ENABLED=true.
BINANCE_TESTNET=true
# Off by default. Must be exactly "true", together with BINANCE_TESTNET=false,
# before any order is sent to https://api.binance.com.
LIVE_TRADING_ENABLED=false
# Broker orders (testnet or live) are refused unless the request sends
# Authorization: Bearer <this value>. Leave unset to block every broker order.
# Do not prefix this with NEXT_PUBLIC_ — it must never reach the browser.
TRADING_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Risk guard (checked before EVERY real order) ---
KILL_SWITCH=false
MAX_POSITION_USD=100
MAX_OPEN_POSITIONS=3
DAILY_LOSS_LIMIT_USD=50
