# MiroFish Trader Configuration

# ===== CLAUDE API =====
ANTHROPIC_API_KEY=sk-ant-...

# ===== ALPACA (Primary Broker - US Stocks) =====
ALPACA_API_KEY=...
ALPACA_SECRET_KEY=...
ALPACA_ENDPOINT=https://paper-trading-api.alpaca.markets  # paper-trading or live
ALPACA_PAPER_TRADING=true

# ===== INTERACTIVE BROKERS =====
IB_ACCOUNT_ID=DU123456
IB_CLIENT_ID=10001
IB_HOST=localhost
IB_PORT=7497
IB_MODE=paper  # paper or live

# ===== KRAKEN (Crypto) =====
KRAKEN_API_KEY=...
KRAKEN_API_SECRET=...
KRAKEN_FUNDING_KEY=...
KRAKEN_MODE=sandbox  # sandbox or live

# ===== ZERODHA (NSE India) =====
ZERODHA_API_KEY=...
ZERODHA_ACCESS_TOKEN=...
ZERODHA_PUBLIC_TOKEN=...

# ===== MIROFISH SWARM CONFIG =====
SWARM_NUM_AGENTS=3
SWARM_MODE=paper-trading  # paper-trading or live-trading
SWARM_RISK_LIMIT=10000     # Max portfolio drawdown ($)
SWARM_POSITION_LIMIT=100000 # Max single position ($)
SWARM_DAILY_LOSS_LIMIT=5000 # Stop trading if lose this much per day
SWARM_UPDATE_INTERVAL=60    # Seconds between trading cycles

# ===== VIBETRADE CONFIG =====
VIBETRADE_BROKER=alpaca    # Primary broker for VibeTrade (alpaca, ib, kraken, zerodha)
VIBETRADE_MODE=paper       # paper or live

# ===== DATA SOURCES =====
YAHOO_FINANCE_ENABLED=true
RSS_FEEDS=https://feeds.bloomberg.com/markets/rss.xml,https://feeds.cnbc.com/...
MARKET_DATA_CACHE_TTL=30   # Cache market data for 30 seconds

# ===== DASHBOARD CONFIG =====
DASHBOARD_PORT=3000
DASHBOARD_AUTH_TOKEN=...   # Optional: require token to access dashboard

# ===== MONITORING =====
LOG_LEVEL=info             # debug, info, warn, error
LOG_DIR=./logs
METRICS_EXPORT=true        # Enable Prometheus metrics
METRICS_PORT=9090

# ===== SECURITY =====
ENABLE_ORDER_CONFIRMATION=true  # Require manual approval for trades
ENABLE_AUDIT_LOG=true
ENABLE_IP_WHITELIST=false
ALLOWED_IPS=127.0.0.1       # Comma-separated

# ===== ENVIRONMENT =====
NODE_ENV=development        # development, staging, production
