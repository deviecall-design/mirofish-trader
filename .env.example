NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRON_SECRET=
ANTHROPIC_API_KEY=
FRED_API_KEY=

# Equities quotes. Server only — do not prefix with NEXT_PUBLIC_.
# Leave empty to keep using Yahoo Finance. When set, EODHD is the primary
# source and Yahoo is only the fallback. Add the key in Vercel for both
# Production and Preview, then redeploy.
EODHD_API_KEY=

# --- Live execution (Binance, testnet-first) ---
# Execution stays fully paper unless EXECUTION_ENABLED=true AND keys are set.
EXECUTION_ENABLED=false
# true (default) = testnet.binance.vision; ONLY set false after a verified
# end-to-end testnet trade — false means real money.
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Risk guard (checked before EVERY real order) ---
KILL_SWITCH=false
MAX_POSITION_USD=100
MAX_OPEN_POSITIONS=3
DAILY_LOSS_LIMIT_USD=50
